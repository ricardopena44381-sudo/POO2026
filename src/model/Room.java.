package model;

public abstract class Room {
    protected String number;
    protected int floor;
    protected boolean seaView;
    protected double baseRate;

    public Room(String number, int floor, boolean seaView, double baseRate) {
        this.number = number;
        this.floor = floor;
        this.seaView = seaView;
        this.baseRate = baseRate;
    }

    public abstract double calculateTotalRate(int guests);
    public String getNumber() { return number; }
}
