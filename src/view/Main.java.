package view;

import model.*;

public class Main {
    public static void main(String[] args) {
        System.out.println("==================================================");
        System.out.println("   SISTEMA DE GESTION HOTELERA (Fiel a UML)     ");
        System.out.println("==================================================\n");

        // 1. Crear el Hotel
        Hotel hotel = new Hotel("H1", "Hotel Mar de Cristal", "Av. Principal #123");

        // 2. Crear Habitaciones según la jerarquía de herencia del diagrama
        SingleRoom single = new SingleRoom(101, 50000.0);
        DoubleRoom doubleRoom = new DoubleRoom(201, 70000.0, 20000.0);
        FamilyRoom family = new FamilyRoom(301, 6, 120000.0, 4, 15000.0);
        Suite suite = new Suite(801, 150000.0, 50000.0);

        // Probar agregación de servicios en habitación
        Service tvPremium = new Service("S1", "TV Premium", "Canales HD de películas");
        suite.addService(tvPremium);

        // Registrar en el hotel
        hotel.addRoom(single);
        hotel.addRoom(doubleRoom);
        hotel.addRoom(family);
        hotel.addRoom(suite);

        System.out.println("-> Hotel y habitaciones creadas exitosamente.");

        // 3. Crear Huésped
        Guest guest = new Guest("G1", "Ana Gómez", "10203040", "3001234567", "ana@email.com");

        // 4. Crear Reserva y Polimorfismo en calculateTotal()
        Reservation res = new Reservation("RES-100", guest, suite, 2, 3);
        System.out.println("Costo total calculado para la Suite (3 noches): $" + res.calculateTotal());

        // 5. Confirmar Reserva y Generar Comprobante (Voucher)
        Voucher voucher = res.confirm();
        System.out.println("Reserva confirmada.");
        System.out.println("ID Comprobante (Voucher): " + voucher.getId());
        System.out.println("Monto en comprobante     : $" + voucher.getTotalValue());
        System.out.println("\n==================================================");
    }
}
